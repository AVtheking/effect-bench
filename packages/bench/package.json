{
  "name": "@avtheking/bench",
  "version": "0.0.0",
  "description": "Benchmarks for Effect code, built for agents and CI",
  "type": "module",
  "bin": {
    "effect-bench": "./src/cli/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./cli": "./src/cli/index.ts"
  },
  "files": [
    "dist/src",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "effect-bench": "./dist/src/cli/bin.js"
    },
    "exports": {
      ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" },
      "./node": { "types": "./dist/src/node/index.d.ts", "default": "./dist/src/node/index.js" },
      "./cli": { "types": "./dist/src/cli/index.d.ts", "default": "./dist/src/cli/index.js" }
    }
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.1.2",
    "effect": "^4.1.2"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.2",
    "effect": "4.1.2"
  }
}
